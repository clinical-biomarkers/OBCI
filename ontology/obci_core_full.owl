        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_some_aspect_of</oboInOwl:id>
        <oboInOwl:shorthand rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_some_aspect_of</oboInOwl:shorthand>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated by difference in some aspect of</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby &apos;e&apos; is--to some statistically significant degree--different in some respect from normal (for an individual or population of interest).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:hasDbXref>
