        <oboInOwl:hasDbXref>ICD9CM:084</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34797</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:673</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2023_03_01:154374002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024530</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">induced malaria</oboInOwl:hasExactSynonym>
