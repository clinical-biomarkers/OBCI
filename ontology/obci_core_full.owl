    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000004 -->

    <owl:Class rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000004">
        <owl:equivalentClass>
            <owl:Class>
