    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000014 -->

    <owl:ObjectProperty rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000014">
        <rdfs:subPropertyOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000020"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby the level of &apos;e&apos; is--to some statistically significant degree--outside the range typically considered normal (for an individual or population of interest).</obo:IAO_0000115>
        <obo:IAO_0000116>&apos;Level&apos; here can refer to raw counts, percentages, ratios, concentrations, activities, etc., that can be measured along a continuum scale.</obo:IAO_0000116>
        <obo:IAO_0000116>&apos;Range&apos; here can be as small as a single point; that is, a threshold. In such case, falling outside the range would mean above or below that threshold.</obo:IAO_0000116>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:100000014</oboInOwl:hasDbXref>
