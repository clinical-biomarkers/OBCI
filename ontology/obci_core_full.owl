    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and an anatomical source &apos;a&apos;, whereby a sample of &apos;a&apos; is used to determine some quality of an assessed entity &apos;e&apos;.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000019 -->

    <owl:ObjectProperty rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000019">
        <rdfs:subPropertyOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000020"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby &apos;e&apos; is found to be either present or absent (as compared to an individual or population of interest).</obo:IAO_0000115>
        <obo:IAO_0000116>An &quot;abnormal&quot; condition would be indicated by either the presence of &apos;e&apos; in cases where it is typically absent, or absence of &apos;e&apos; in cases where it is typically present. A &quot;normal&quot; condition would be indicated by either the presence of &apos;e&apos; in cases where it is typically present, or the absence of &apos;e&apos; in cases where it is typically absent.</obo:IAO_0000116>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:100000019</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_presence_of</oboInOwl:id>
        <oboInOwl:shorthand rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_presence_of</oboInOwl:shorthand>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated by difference in presence of</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby &apos;e&apos; is found to be either present or absent (as compared to an individual or population of interest).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000020 -->

    <owl:ObjectProperty rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000020">
        <rdfs:subPropertyOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000021"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby the quantity of &apos;e&apos; is--to some statistically significant degree--different from the quantity typically considered normal (for an individual or population of interest).</obo:IAO_0000115>
        <obo:IAO_0000116>&apos;Quantity&apos; here can refer to (1) raw counts, percentages, ratios, concentrations, activities, etc., that can be measured along a continuum scale; or (2) existence (presence or absence).</obo:IAO_0000116>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:100000020</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_quantity_of</oboInOwl:id>
        <oboInOwl:shorthand rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_quantity_of</oboInOwl:shorthand>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated by difference in quantity of</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000020"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby the quantity of &apos;e&apos; is--to some statistically significant degree--different from the quantity typically considered normal (for an individual or population of interest).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000021 -->

    <owl:ObjectProperty rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000021">
