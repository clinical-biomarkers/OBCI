        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_level_of</oboInOwl:id>
        <oboInOwl:shorthand rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated_by_difference_in_level_of</oboInOwl:shorthand>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">indicated by difference in level of</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby the level of &apos;e&apos; is--to some statistically significant degree--outside the range typically considered normal (for an individual or population of interest).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000015 -->

    <owl:ObjectProperty rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000015">
        <rdfs:subPropertyOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000014"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A relationship between a biomarker &apos;b&apos; and its assessed entity &apos;e&apos;, whereby the level of &apos;e&apos; is--to some statistically significant degree--below the range typically considered normal (for an individual or population of interest).</obo:IAO_0000115>
        <obo:IAO_0000116>&apos;Level&apos; here can refer to raw counts, percentages, ratios, concentrations, activities, etc., that can be measured along a continuum scale.</obo:IAO_0000116>
        <obo:IAO_0000116>&apos;Range&apos; here can be as small as a single point; that is, a threshold. In such case, being below the range would mean being less than that threshold value.</obo:IAO_0000116>
        <oboInOwl:created_by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:100000015</oboInOwl:hasDbXref>
