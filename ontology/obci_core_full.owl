<?xml version="1.0"?>
<rdf:RDF xmlns="https://github.com/clinical-biomarkers/OBCI/blob/main/ontology/obci_core_full.owl#"
     xml:base="https://github.com/clinical-biomarkers/OBCI/blob/main/ontology/obci_core_full.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://github.com/clinical-biomarkers/OBCI/blob/main/ontology/obci_core_full.owl">
        <terms:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Ontology for Biomarkers of Clinical Interest (OBCI) formally defines biomarkers for diseases, phenotypes, and effects.</terms:description>
        <terms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
        <terms:title rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ontology for Biomarkers of Clinical Interest</terms:title>
        <oboInOwl:default-namespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:default-namespace>
        <oboInOwl:saved-by rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://github.com/nataled</oboInOwl:saved-by>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Ontology for Biomarkers of Clinical Interest is licensed under CC BY 4.0. Please see http://obofoundry.org/ontology/obci for details.</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use the Hermit reasoner in Protege to see the correct hierarchy.</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-26</owl:versionInfo>
    </owl:Ontology>
    


