        <oboInOwl:hasDbXref>UMLS_CUI:C0019693</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">HIV infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
