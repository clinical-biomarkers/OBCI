    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000005 -->

    <owl:Class rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000005">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0020330"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000011"/>
                                <owl:hasValue rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000086"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000012"/>
                                <owl:hasValue rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000090"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000016"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biomarker that is used to identify individuals who are more likely than similar individuals without the biomarker to experience a favorable or unfavorable effect from exposure to a medical product or an environmental agent.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predictive evidence type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:000000005</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Per CIVic, such biomarkers help predict drug sensitivity or therapeutic response and are valuable in deciding further treatments. Predictive evidence items often explain mechanisms of drug resistance.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predictive biomarker</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biomarker that is used to identify individuals who are more likely than similar individuals without the biomarker to experience a favorable or unfavorable effect from exposure to a medical product or an environmental agent.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDA-NIH Biomarker Working Group</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCBI:books/NBK402283</oboInOwl:hasDbXref>
        <rdfs:seeAlso>PMID:29405771</rdfs:seeAlso>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000005"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">predictive evidence type</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:31796060</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000006 -->

    <owl:Class rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000006">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0020331"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DOID_4"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C156809"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000011"/>
                                <owl:hasValue rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000085"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000012"/>
                                <owl:hasValue rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000092"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000016"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biomarker that is used to identify the likelihood of a clinical event, disease recurrence or progression in patients who have the disease or medical condition of interest.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prognostic evidence type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:000000006</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Per CIVic, such biomarkers are those that predict survival outcome.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prognostic biomarker</rdfs:label>
    </owl:Class>
    <owl:Axiom>
