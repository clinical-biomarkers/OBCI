        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>UMLS:C0007806</owl:annotatedTarget>
        <oboInOwl:source>BIRNLEX:1798</oboInOwl:source>
        <oboInOwl:source>ncithesaurus:Cerebrospinal_Fluid</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001359"/>
