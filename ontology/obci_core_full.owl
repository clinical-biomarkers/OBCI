    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001 -->

    <owl:Class rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002607"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DOID_4"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/ExO_0000002"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C156809"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </owl:equivalentClass>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A defined characteristic that is measured as an indicator of normal biological processes, pathogenic processes, or biological responses to an exposure or intervention, including therapeutic interventions.</obo:IAO_0000115>
        <obo:IAO_0000116>Biomarkers require comparison between characteristics of interest obtained in test cases vs those in normal cases. What is considered &apos;normal&apos; will depend on the biomarker; in some cases the comparison will be to a population average, in others it will be to an individual&apos;s known healthy state.</obo:IAO_0000116>
        <obo:IAO_0000116>We make a distinction between &apos;biomarker&apos; and &apos;biomarker assessed entity&apos;. The former derives from result of measurement or observation of the latter. For example, in and of itself, &apos;blood sugar&apos; is not considered a biomarker in our treatment, but &apos;elevated blood sugar&apos; is. Another example is BRCA1; despite appearing on lists of cancer-implicated genes, BRCA1 is _not_ a biomarker of cancer in our treatment. However, the presence of a particular allele of BRCA1 can be a biomarker, or BRCA1 over-expression can be a biomarker.</obo:IAO_0000116>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:000000001</oboInOwl:id>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular, histologic, radiographic, or physiologic characteristics are types of biomarkers. A biomarker is not an assessment of how an individual feels, functions, or survives.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A defined characteristic that is measured as an indicator of normal biological processes, pathogenic processes, or biological responses to an exposure or intervention, including therapeutic interventions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDA-NIH Biomarker Working Group</oboInOwl:hasDbXref>
        <rdfs:seeAlso>PMID:29405771</rdfs:seeAlso>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecular, histologic, radiographic, or physiologic characteristics are types of biomarkers. A biomarker is not an assessment of how an individual feels, functions, or survives.</owl:annotatedTarget>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDA-NIH Biomarker Working Group</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000002 -->

    <owl:Class rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000001"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0020327"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DOID_4"/>
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/NCIT_C156809"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000011"/>
                                <owl:hasValue rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000083"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:100000012"/>
                                <owl:hasValue rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000089"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000016"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biomarker that is used to detect or confirm the presence of a disease or condition of interest or to identify individuals with a subtype of the disease.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5809-9523</oboInOwl:created_by>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diagnostic evidence type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">biomarker</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBCI:000000002</oboInOwl:id>
        <rdfs:comment>For a perfect diagnostic biomarker test, all patients with the disease or disease subset would be detected (100% sensitivity, i.e., the fraction of people with disease who test positive) and no patients without the disease would be diagnosed with the disease (100% specificity, i.e., the fraction of people without the disease who test negative). In practice no biomarker test has perfect clinical and analytical sensitivity and specificity. [NCBI:books/NBK402285]</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Per CIVic, such biomarkers can help a clinician diagnose or exclude a particular disease.</rdfs:comment>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diagnostic biomarker</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A biomarker that is used to detect or confirm the presence of a disease or condition of interest or to identify individuals with a subtype of the disease.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDA-NIH Biomarker Working Group</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCBI:books/NBK402285</oboInOwl:hasDbXref>
        <rdfs:seeAlso>PMID:29405771</rdfs:seeAlso>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diagnostic evidence type</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:31796060</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000003 -->

    <owl:Class rdf:about="http://proteininformationresource.org/cgi-bin/show_obci?id=OBCI:000000003">
