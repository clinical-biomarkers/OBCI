            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A complex of two or more molecules that are not covalently bound.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">complex of molecules</rdfs:label>
    </owl:Class>
    


